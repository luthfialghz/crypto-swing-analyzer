# Configuration for target coins
NEXT_PUBLIC_DEFAULT_TARGET_COINS=bitcoin,ethereum,cardano,polkadot,litecoin,chainlink,stellar,monero,vechain,iota

# Discord Notification Configuration
# Ganti dengan Discord webhook URL Anda
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Untuk menampilkan status konfigurasi di UI (NEXT_PUBLIC agar bisa diakses di client-side)
NEXT_PUBLIC_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN